{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProteinDesign-Eval candidate",
  "type": "object",
  "required": ["candidate_id", "sequence"],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "string", "pattern": "^[ACDEFGHIKLMNPQRSTVWY\\s]+$" },
    "structure_path": { "type": ["string", "null"] },
    "design_method": { "type": ["string", "null"] },
    "generation_round": { "type": ["string", "null"] }
  }
}